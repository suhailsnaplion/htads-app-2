# Copy to .env for local development. On Render, these are set via render.yaml / dashboard.

# Postgres connection string. Render provides this automatically when you add
# a Postgres instance and link it via render.yaml (see DATABASE_URL there).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/htads

# Secret used to sign login sessions (JWTs). Render's render.yaml auto-generates
# this in production. For local dev, any random string works.
JWT_SECRET=change-me-to-a-long-random-string

# Port the Express server listens on. Render sets this automatically.
PORT=8080

# ── WhatsApp Business API (optional) ──────────────────────────────────────
# Leave these unset to run in "simulated" mode — the Test the Message button
# will work and log to the database, but will not contact Meta.
# Fill these in once you have a Meta WhatsApp Business API app:
WHATSAPP_ACCESS_TOKEN=

# Each WhatsApp channel in the whatsapp_channels table also needs its own
# wa_phone_number_id set (from Meta) before it can send for real — update
# via SQL or a future admin screen:
#   UPDATE whatsapp_channels SET wa_phone_number_id = '123456789' WHERE id = 'wa_htauto_primary';
